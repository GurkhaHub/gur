	local function closeTeleportPanel()
		if closing or not panel.Parent then return end
		closing = true
		teleportBusy = true
		closePanel.Active = false
		back.Active = false
		retryBtn.Active = false

		local slideOut = TweenService:Create(panel, TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
			Position = UDim2.new(1, 650, 0.5, 0),
		})
		local restoreMain = TweenService:Create(main, TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
			Size = NORMAL_SIZE,
		})
		slideOut:Play()
		restoreMain:Play()
		slideOut.Completed:Wait()
		if panel.Parent then panel:Destroy() end
		teleportPanel = nil
		teleportBusy = false
	end

	closePanel.MouseButton1Click:Connect(closeTeleportPanel)
	back.MouseButton1Click:Connect(closeTeleportPanel)

	TweenService:Create(panel, TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
		Position = UDim2.fromScale(0.5, 0.5),
	}):Play()

	local function attemptTeleport()
		if not panel.Parent or closing then return end
		teleportBusy = true
		retryBtn.Visible = false
		retryBtn.Active = false
		closePanel.Active = false
		back.Active = false
		info.TextColor3 = SUBTEXT
		info.Text = "Preparing teleport to PlaceId " .. tostring(gameData.PlaceId)
		progressLabel.Text = "CONNECTING TO ROBLOX..."
		progress.Size = UDim2.new(0, 0, 1, 0)

		task.spawn(function()
			for i = 0, 100 do
				if not progress.Parent or closing then return end
				progress.Size = UDim2.new(i / 100, 0, 1, 0)
				if i < 30 then
					progressLabel.Text = "CONNECTING TO ROBLOX..."
				elseif i < 65 then
					progressLabel.Text = "PREPARING TELEPORT..."
				else
					progressLabel.Text = "SENDING REQUEST..."
				end
				task.wait(0.02)
			end
		end)

		task.delay(0.9, function()
			if not panel.Parent or closing then return end
			if typeof(gameData.PlaceId) ~= "number" or gameData.PlaceId <= 0 then
				info.TextColor3 = RED
				info.Text = "Invalid destination PlaceId."
				progressLabel.Text = "TELEPORT FAILED"
				retryBtn.Visible = true
				retryBtn.Active = true
				closePanel.Active = true
				back.Active = true
				teleportBusy = false
				return
			end

			info.Text = "Requesting teleport through Roblox..."
			progressLabel.Text = "OPENING " .. string.upper(gameData.Name) .. "..."

			local success, err = pcall(function()
				TeleportService:Teleport(gameData.PlaceId, player)
			end)

			if not success then
				info.TextColor3 = RED
				info.Text = "Teleport request failed: " .. tostring(err)
				progressLabel.Text = "TELEPORT FAILED"
				retryBtn.Visible = true
				retryBtn.Active = true
				closePanel.Active = true
				back.Active = true
				teleportBusy = false
			end
		end)
	end

	retryBtn.MouseButton1Click:Connect(function()
		if teleportBusy or closing then return end
		teleportBusy = true
		attemptTeleport()
	end)

	attemptTeleport()
end

