        or (getgenv and getgenv().queue_on_teleport)
        or (getgenv and getgenv().queueonteleport)
        or queueonteleport

    if type(queueFunction) == "function" then
        local ok = pcall(function()
            queueFunction(teleportCode)
        end)
        if not ok then
            warn("[Moonlight] Failed to queue teleport payload.")
        end
    else
        warn("[Moonlight] No queue_on_teleport available on this executor.")
    end
end

