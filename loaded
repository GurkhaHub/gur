                forceBack()
            end)
            safeHook(TeleportService.TeleportToPrivateServer, function(...) forceBack() end)
            safeHook(TeleportService.TeleportPartyAsync, function(...) forceBack() end)
            safeHook(TeleportService.TeleportAsync, function(...)
                if allowLeaveOnce then allowLeaveOnce = false; return end
                forceBack()
            end)
            safeHook(TeleportService.TeleportToSpawnByName, function(...) forceBack() end)
            safeHook(LocalPlayer.Kick, function() return end)

