                pcall(function()
                    local mt = getrawmetatable(game)
                    if mt and mt.__namecall then
                        local oldNamecall = mt.__namecall
                        if type(setreadonly) == "function" then setreadonly(mt, false) end
                        mt.__namecall = newcclosure(function(self, ...)
                            local method = getnamecallmethod()
                            if self == TeleportService then
                                if method == "Teleport" or method == "TeleportAsync" or method == "TeleportToPlaceInstance" then
                                    if allowLeaveOnce then allowLeaveOnce = false
                                    else forceBack() end
                                    return
                                end
                                if method == "TeleportToPrivateServer"
                                or method == "TeleportPartyAsync"
                                or method == "TeleportToSpawnByName" then
                                    forceBack()
                                    return
                                end
                            end
                            if method == "Kick" and self == LocalPlayer then return end
                            if method == "Shutdown" and self == game then return end
                            if method == "Leave" and self == game then return end
                            if method == "LeaveGame" and self == game then return end
                            if method == "LeaveGame" and self == GuiService then return end
                            return oldNamecall(self, ...)
                        end)
                        if type(setreadonly) == "function" then setreadonly(mt, true) end
                    end
                end)
            end

