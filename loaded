	{ Time = 0,   Text = "Detecting Roblox account..." },
	{ Time = 1.2, Text = "Logging in as @" .. player.Name .. "..." },
	{ Time = 2.5, Text = "Verifying player session..." },
	{ Time = 3.7, Text = "Loading interface..." },
	{ Time = 5.0, Text = "Preparing games..." },
	{ Time = 6.5, Text = "Loading assets..." },
	{ Time = 8.0, Text = "Finalizing your session..." },
	{ Time = 9.2, Text = "Almost ready..." },
}

main.Visible = false

task.spawn(function()
	local startTime = os.clock()
	local statusIndex = 1

	while true do
		local elapsed = os.clock() - startTime
		local progressValue = math.clamp(elapsed / 10, 0, 1)
		progressFill.Size = UDim2.new(progressValue, 0, 1, 0)
		percentage.Text = math.floor(progressValue * 100) .. "%"

		for i = #loadingStatuses, 1, -1 do
			if elapsed >= loadingStatuses[i].Time then
				if statusIndex ~= i then
					statusIndex = i
					loadingStatus.TextTransparency = 1
					TweenService:Create(loadingStatus, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
				end
				loadingStatus.Text = loadingStatuses[i].Text
				break
			end
		end

		if elapsed >= 10 then break end
		RunService.RenderStepped:Wait()
	end

	progressFill.Size = UDim2.new(1, 0, 1, 0)
	percentage.Text = "100%"
	loadingStatus.Text = "Welcome, @" .. player.Name .. "!"
	loadingFooter.Text = "READY"

	task.wait(0.35)

	local fadeInfo = TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	main.Visible = true

	TweenService:Create(loadingContainer, fadeInfo, {BackgroundTransparency = 1, Size = UDim2.fromOffset(375, 225)}):Play()

	for _, object in ipairs({loadingTitle, loadingSubtitle, usernameText, loadingStatus, percentage, loadingFooter}) do
		TweenService:Create(object, fadeInfo, {TextTransparency = 1}):Play()
	end
	for _, object in ipairs({containerStroke, spinnerStroke, spinnerArcStroke}) do
		TweenService:Create(object, fadeInfo, {Transparency = 1}):Play()
	end

	TweenService:Create(profileImage, fadeInfo, {ImageTransparency = 1}):Play()
	TweenService:Create(progressBackground, fadeInfo, {BackgroundTransparency = 1}):Play()
	TweenService:Create(progressFill, fadeInfo, {BackgroundTransparency = 1}):Play()
	TweenService:Create(topGlow, fadeInfo, {BackgroundTransparency = 1}):Play()

	task.wait(0.7)
	if spinnerConnection then spinnerConnection:Disconnect() end
	if loading.Parent then loading:Destroy() end
	main.Visible = true
end)
