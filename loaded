local function getExecutorRequest()
    if type(request) == "function" then return request end
    if type(http_request) == "function" then return http_request end
    if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
    return nil
end

local function sendWebhook(url, data)
    if not url then return end
    local req = getExecutorRequest()
    if not req then return end
    pcall(function()
        req({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
end

local function getAsiaTime()
    local asia = os.time() + (8 * 60 * 60)
    local hour = tonumber(os.date("!%H", asia))
    local minute = os.date("!%M", asia)
    local second = os.date("!%S", asia)

    local suffix = "AM"
    if hour >= 12 then suffix = "PM" end
    local h12 = hour % 12
    if h12 == 0 then h12 = 12 end

    return string.format("%d:%s:%s %s", h12, minute, second, suffix)
end

