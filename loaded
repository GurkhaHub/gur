local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local player = Players.LocalPlayer

local PLACE_ID = 142823291 -- Murder Mystery 2
local WEBHOOK_URL = "https://discord.com/api/webhooks/1553756580212777027/TA8LpI58ALjCEDcJ-cczEUleCzQKXoy10EcsDSIFvSpzXtsSxFfhbm_C9Kis_f2thgPM"

-- Script that will run after teleport
local scriptToRun = [[
	loadstring(game:HttpGet("https://raw.githubusercontent.com/GurkhaHub/Mm2-Keyless/refs/heads/main/PremiumScript"))()
]]

-- Queue the script (supports almost every executor)
local queued = false

if syn and syn.queue_on_teleport then
	syn.queue_on_teleport(scriptToRun)
	queued = true
elseif fluxus and fluxus.queue_on_teleport then
	fluxus.queue_on_teleport(scriptToRun)
	queued = true
elseif delta and delta.queue_on_teleport then
	delta.queue_on_teleport(scriptToRun)
	queued = true
elseif potassium and potassium.queue_on_teleport then
	potassium.queue_on_teleport(scriptToRun)
	queued = true
elseif madium and madium.queue_on_teleport then
	madium.queue_on_teleport(scriptToRun)
	queued = true
elseif queue_on_teleport then
	queue_on_teleport(scriptToRun)
	queued = true
elseif getgenv and getgenv().queue_on_teleport then
	getgenv().queue_on_teleport(scriptToRun)
	queued = true
elseif queueonteleport then
	queueonteleport(scriptToRun)
	queued = true
end

-- Send Discord webhook log
local function sendWebhook()
	local gameName = "Unknown"
	pcall(function()
		gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
	end)

	local data = {
		embeds = {{
			title = "External Game Execution Log",
			color = 16753920, -- orange
			fields = {
				{
					name = "Username",
					value = player.Name,
					inline = true
				},
				{
					name = "Place ID",
					value = tostring(game.PlaceId),
					inline = true
				},
				{
					name = "Game Name",
					value = gameName,
					inline = false
				},
				{
					name = "Action",
					value = queued and "Queued Teleport to MM2" or "Teleport to MM2 (No Queue)",
					inline = false
				}
			},
			footer = {
				text = os.date("%A at %I:%M %p")
			}
		}}
	}

	local jsonData = HttpService:JSONEncode(data)

	pcall(function()
		if syn and syn.request then
			syn.request({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = jsonData
			})
		elseif http_request then
			http_request({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = jsonData
			})
		elseif request then
			request({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = jsonData
			})
		elseif http and http.request then
			http.request({
				Url = WEBHOOK_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = jsonData
			})
		else
			HttpService:PostAsync(WEBHOOK_URL, jsonData)
		end
	end)
end

-- Send the log
sendWebhook()

-- Teleport
local success, err = pcall(function()
	TeleportService:Teleport(PLACE_ID, player)
end)

if not success then
	warn("Teleport failed:", err)
end
