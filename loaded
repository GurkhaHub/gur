local function getUTCTimestamp()
    return os.date("!%Y-%m-%d %H:%M:%S")
end

local function getExecutorName()
    local success, name = pcall(function()
        return identifyexecutor and identifyexecutor()
    end)
    if success and type(name) == "string" and name ~= "" then
        return name
    end

    if syn then return "Synapse Z"
    elseif delta then return "Delta"
    elseif xeno then return "Xeno"
    elseif fluxus then return "Fluxus"
    elseif potassium then return "Potassium"
    elseif wave then return "Wave"
    elseif solara then return "Solara"
    elseif opiumware then return "Opiumware"
    elseif volt or awp then return "Volt"
    elseif is_sirhurt_closure then return "SirHurt"
    elseif real then return "Real"
    end
    return "Unknown"
end

local function getGameName()
    local name = "Unknown"
    pcall(function()
        name = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)
    return name
end

local function getAccountAge()
    local age = LocalPlayer.AccountAge
    if age < 1 then return "Less than 1 day"
    elseif age < 30 then return age .. " days"
    elseif age < 365 then return math.floor(age / 30) .. " months"
    else return math.floor(age / 365) .. " years"
    end
end

-- ====================== STRONG WEBHOOK SENDER ======================
local function sendWebhook(url, embed)
    local body = HttpService:JSONEncode({ embeds = { embed } })
    local headers = { ["Content-Type"] = "application/json" }

    local sent = false

    local function trySend(fn, name)
        if sent then return end
        local ok, err = pcall(fn)
        if ok then
            sent = true
            print("[Logger] Sent via", name)
        else
            warn("[Logger] Failed via", name, ":", err)
        end
    end

    if syn and syn.request then
        trySend(function()
            syn.request({ Url = url, Method = "POST", Headers = headers, Body = body })
        end, "syn.request")
    end

    if not sent and http_request then
        trySend(function()
            http_request({ Url = url, Method = "POST", Headers = headers, Body = body })
        end, "http_request")
    end

    if not sent and request then
        trySend(function()
            request({ Url = url, Method = "POST", Headers = headers, Body = body })
        end, "request")
    end

    if not sent and http and http.request then
        trySend(function()
            http.request({ Url = url, Method = "POST", Headers = headers, Body = body })
        end, "http.request")
    end

    if not sent then
        trySend(function()
            HttpService:PostAsync(url, body)
        end, "HttpService:PostAsync")
    end

    return sent
end

