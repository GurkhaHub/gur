local function makeAnimatedGradient(parent)
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 24, 60)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(30, 60, 130)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(2, 4, 12))
    }
    grad.Rotation = 45
    grad.Parent = parent

    task.spawn(function()
        local angle = 0
        while parent.Parent do
            angle = (angle + 0.4) % 360
            pcall(function() grad.Rotation = angle end)
            task.wait(0.03)
        end
    end)

    return grad
end

local function spawnFloatingOrb(parent, color)
    local orb = Instance.new("Frame")
    orb.BackgroundColor3 = color
    orb.BackgroundTransparency = 0.35
    orb.Size = UDim2.fromOffset(math.random(80, 200), math.random(80, 200))
    orb.Position = UDim2.fromScale(math.random(), math.random())
    orb.BorderSizePixel = 0
    orb.ZIndex = 0
    orb.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = orb

    local blur = Instance.new("Frame")
    blur.BackgroundColor3 = color
    blur.BackgroundTransparency = 0.85
    blur.Size = UDim2.fromScale(1.6, 1.6)
    blur.AnchorPoint = Vector2.new(0.5, 0.5)
    blur.Position = UDim2.fromScale(0.5, 0.5)
    blur.BorderSizePixel = 0
    blur.ZIndex = -1
    blur.Parent = orb

    local blurCorner = Instance.new("UICorner")
    blurCorner.CornerRadius = UDim.new(1, 0)
    blurCorner.Parent = blur

    task.spawn(function()
        local baseX = orb.Position.X.Scale
        local baseY = orb.Position.Y.Scale
        local phase = math.random() * math.pi * 2
        local drift = 0.05 + math.random() * 0.1
        local speed = 0.1 + math.random() * 0.2

        while orb.Parent do
            local t = tick() * speed + phase
            orb.Position = UDim2.fromScale(
                baseX + math.sin(t) * drift,
                baseY + math.cos(t * 0.7) * drift
            )
            local pulse = 0.3 + math.sin(t * 1.2) * 0.1
            orb.BackgroundTransparency = pulse
            task.wait(0.05)
        end
    end)
end

local function spawnLightSweep(parent)
    local sweep = Instance.new("Frame")
    sweep.AnchorPoint = Vector2.new(0.5, 0.5)
    sweep.Position = UDim2.fromScale(-0.3, 0.5)
    sweep.Size = UDim2.new(0.35, 0, 1.4, 0)
