local rainbowObjects = {}

local function createRainbowEffect(target, cornerRadius)
	local container = Instance.new("Frame")
	container.Name = "RainbowBorder"
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.fromScale(1, 1)
	container.ClipsDescendants = true
	container.Active = false
	container.ZIndex = 1
	container.Parent = target

	local containerCorner = Instance.new("UICorner")
	containerCorner.CornerRadius = UDim.new(0, cornerRadius)
	containerCorner.Parent = container

	local glowContainer = Instance.new("Frame")
	glowContainer.Name = "RainbowGlow"
	glowContainer.BackgroundTransparency = 1
	glowContainer.BorderSizePixel = 0
	glowContainer.Size = UDim2.fromScale(1, 1)
	glowContainer.ClipsDescendants = true
	glowContainer.Active = false
	glowContainer.ZIndex = 1
	glowContainer.Parent = target

	local glowCorner = Instance.new("UICorner")
	glowCorner.CornerRadius = UDim.new(0, cornerRadius)
	glowCorner.Parent = glowContainer

	local segments = {}
	local distances = {}

	for i = 1, RAINBOW_SEGMENTS do
		local hue = (i - 1) / RAINBOW_SEGMENTS

		local glow = Instance.new("Frame")
		glow.Name = "Glow_" .. i
		glow.BackgroundColor3 = Color3.fromHSV(hue, RAINBOW_SATURATION, RAINBOW_BRIGHTNESS)
		glow.BackgroundTransparency = RAINBOW_GLOW_TRANSPARENCY
		glow.BorderSizePixel = 0
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.Active = false
		glow.ZIndex = 1
		glow.Parent = glowContainer
		Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)

		local segment = Instance.new("Frame")
		segment.Name = "Segment_" .. i
		segment.BackgroundColor3 = Color3.fromHSV(hue, RAINBOW_SATURATION, RAINBOW_BRIGHTNESS)
		segment.BorderSizePixel = 0
		segment.AnchorPoint = Vector2.new(0.5, 0.5)
		segment.Active = false
		segment.ZIndex = 2
		segment.Parent = container
		Instance.new("UICorner", segment).CornerRadius = UDim.new(1, 0)

		segments[i] = { Main = segment, Glow = glow }
	end

	local lastWidth, lastHeight = 0, 0

	local function updateGeometry()
		local width = target.AbsoluteSize.X
		local height = target.AbsoluteSize.Y
		if width <= 1 or height <= 1 or (width == lastWidth and height == lastHeight) then return end
		lastWidth, lastHeight = width, height

		local radius = math.min(cornerRadius, width / 2, height / 2)
		if radius <= 0 then return end

		local horizontalLength = math.max(0, width - radius * 2)
		local verticalLength = math.max(0, height - radius * 2)
		local quarterArc = math.pi * radius / 2
		local perimeter = horizontalLength * 2 + verticalLength * 2 + quarterArc * 4
		if perimeter <= 0 then return end

		local segmentLength = perimeter / RAINBOW_SEGMENTS

		for i = 1, RAINBOW_SEGMENTS do
			local distance = (i - 0.5) * segmentLength
			local x, y, rotation = 0, 0, 0

			if distance < horizontalLength then
				x = radius + distance
				y = 0
				rotation = 0
			elseif distance < horizontalLength + quarterArc then
				local arc = distance - horizontalLength
				local angle = -math.pi / 2 + (arc / radius)
				x = (width - radius) + radius * math.cos(angle)
				y = radius + radius * math.sin(angle)
				rotation = math.deg(angle + math.pi / 2)
			elseif distance < horizontalLength + quarterArc + verticalLength then
				local side = distance - horizontalLength - quarterArc
				x = width
				y = radius + side
				rotation = 90
			elseif distance < horizontalLength + quarterArc + verticalLength + quarterArc then
				local arc = distance - horizontalLength - quarterArc - verticalLength
				local angle = arc / radius
				x = (width - radius) + radius * math.cos(angle)
				y = (height - radius) + radius * math.sin(angle)
				rotation = math.deg(angle + math.pi / 2)
			elseif distance < horizontalLength + quarterArc + verticalLength + quarterArc + horizontalLength then
				local side = distance - horizontalLength - quarterArc - verticalLength - quarterArc
				x = width - radius - side
				y = height
				rotation = 180
			elseif distance < horizontalLength + quarterArc + verticalLength + quarterArc + horizontalLength + quarterArc then
				local arc = distance - horizontalLength - quarterArc - verticalLength - quarterArc - horizontalLength
				local angle = math.pi / 2 + (arc / radius)
				x = radius + radius * math.cos(angle)
				y = (height - radius) + radius * math.sin(angle)
				rotation = math.deg(angle + math.pi / 2)
			elseif distance < horizontalLength + quarterArc + verticalLength + quarterArc + horizontalLength + quarterArc + verticalLength then
				local side = distance - horizontalLength - quarterArc - verticalLength - quarterArc - horizontalLength - quarterArc
				x = 0
				y = height - radius - side
				rotation = 270
			else
				local arc = distance - horizontalLength - quarterArc - verticalLength - quarterArc - horizontalLength - quarterArc - verticalLength
				local angle = math.pi + (arc / radius)
				x = radius + radius * math.cos(angle)
				y = radius + radius * math.sin(angle)
				rotation = math.deg(angle + math.pi / 2)
			end

			distances[i] = distance
			local mainSeg = segments[i].Main
			local glowSeg = segments[i].Glow
			mainSeg.Position = UDim2.fromOffset(x, y)
			mainSeg.Size = UDim2.fromOffset(math.max(4, segmentLength + 2), RAINBOW_THICKNESS)
			mainSeg.Rotation = rotation
			glowSeg.Position = UDim2.fromOffset(x, y)
			glowSeg.Size = UDim2.fromOffset(math.max(6, segmentLength + 4), RAINBOW_GLOW_THICKNESS)
			glowSeg.Rotation = rotation
		end
	end

	target:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGeometry)
	task.defer(updateGeometry)

	table.insert(rainbowObjects, {
		Target = target,
		Segments = segments,
		Distances = distances,
	})
end

local rainbowPhase = 0
RunService.RenderStepped:Connect(function(dt)
	rainbowPhase = (rainbowPhase + dt * RAINBOW_SPEED) % 1
	for _, effect in ipairs(rainbowObjects) do
		if effect.Target and effect.Target.Parent and effect.Target.Visible ~= false then
			local width = effect.Target.AbsoluteSize.X
			local height = effect.Target.AbsoluteSize.Y
			local radius = math.min(RAINBOW_CORNER_RADIUS, width / 2, height / 2)
			if radius > 0 then
				local horizontalLength = math.max(0, width - radius * 2)
				local verticalLength = math.max(0, height - radius * 2)
				local quarterArc = math.pi * radius / 2
				local perimeter = horizontalLength * 2 + verticalLength * 2 + quarterArc * 4
				if perimeter > 0 then
					for i = 1, #effect.Segments do
						local distance = effect.Distances[i]
						if distance then
							local hue = (distance / perimeter + rainbowPhase) % 1
							local color = Color3.fromHSV(hue, RAINBOW_SATURATION, RAINBOW_BRIGHTNESS)
							effect.Segments[i].Main.BackgroundColor3 = color
							effect.Segments[i].Glow.BackgroundColor3 = color
						end
					end
				end
			end
		end
	end
end)

