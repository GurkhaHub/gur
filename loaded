local particles = {}
local PARTICLE_COUNT = 12
local PARTICLE_RADIUS = 38

for i = 1, PARTICLE_COUNT do
	local p = Instance.new("Frame")
	p.Name = "Particle_" .. i
	p.Size = UDim2.fromOffset(5, 5)
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.BackgroundColor3 = Color3.fromRGB(255, 90, 140)
	p.BackgroundTransparency = 0.3
	p.BorderSizePixel = 0
	p.ZIndex = 105
	p.Parent = spinner
	Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

	local glow = Instance.new("UIStroke")
	glow.Color = Color3.fromRGB(255, 120, 180)
	glow.Thickness = 2
	glow.Transparency = 0.6
	glow.Parent = p

	particles[i] = {
		Frame = p,
		Offset = (i - 1) * (math.pi * 2 / PARTICLE_COUNT),
		Speed = 1.8 + (i % 3) * 0.15,
		SizeBase = 4 + (i % 3),
	}
end

local spinnerRotation = 0
local particleTime = 0
local spinnerConnection

spinnerConnection = RunService.RenderStepped:Connect(function(dt)
	if not loading.Parent then
		if spinnerConnection then spinnerConnection:Disconnect() end
		return
	end

	spinnerRotation = (spinnerRotation + dt * 220) % 360
	spinnerArc.Rotation = spinnerRotation
	particleTime += dt

	for _, data in ipairs(particles) do
		local angle = data.Offset + particleTime * data.Speed
		local x = math.cos(angle) * PARTICLE_RADIUS
		local y = math.sin(angle) * PARTICLE_RADIUS
		data.Frame.Position = UDim2.new(0.5, x, 0.5, y)

		local pulse = 0.7 + 0.3 * math.sin(particleTime * 3 + data.Offset)
		local size = data.SizeBase * pulse
		data.Frame.Size = UDim2.fromOffset(size, size)
		data.Frame.BackgroundTransparency = 0.25 + 0.35 * (1 - pulse)
	end
end)

