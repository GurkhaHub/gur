local function installMenuHider()
    if MENU_HIDER_STARTED then return end
    MENU_HIDER_STARTED = true

    local function getRobloxGui()
        local rg = CoreGui:FindFirstChild("RobloxGui")
        if rg then return rg end
        local ok, res = pcall(function()
            return game:GetService("CoreGui"):FindFirstChild("RobloxGui")
        end)
        if ok then return res end
        return nil
    end

    local function hideLeaveGui(root)
        if not root then return end
        pcall(function()
            for _, obj in ipairs(root:GetDescendants()) do
                pcall(function()
                    local n = obj.Name
                    if n == "Leave" or n == "LeaveButton" or n == "LeaveGame"
                    or n == "Leave Game" or n == "LeaveGameButton" then
                        if obj:IsA("GuiObject") then
                            obj.Visible = false
                            obj.Active = false
                            obj.Selectable = false
                            if obj:IsA("GuiButton") then obj.Interactable = false end
                            pcall(function() obj.Size = UDim2.new(0,0,0,0) end)
                            pcall(function() obj.BackgroundTransparency = 1 end)
                            pcall(function() obj.TextTransparency = 1 end)
                            pcall(function() obj.Text = "" end)
                        end
                    end
                    if obj:IsA("GuiButton") then
                        local t = obj.Text
                        if type(t) == "string" then
                            local lt = string.lower(t)
                            if lt == "leave" or lt == "leave game" or lt == "leave this game" then
                                obj.Visible = false
                                obj.Active = false
                                obj.Selectable = false
                                obj.Interactable = false
                                pcall(function() obj.Size = UDim2.new(0,0,0,0) end)
                                pcall(function() obj.BackgroundTransparency = 1 end)
                                pcall(function() obj.TextTransparency = 1 end)
                                pcall(function() obj.Text = "" end)
                            end
                        end
                    end
                end)
            end
        end)
    end

    task.spawn(function()
        while true do
            task.wait(0.25)
            pcall(function() hideLeaveGui(getRobloxGui()) end)
            pcall(function() hideLeaveGui(CoreGui) end)
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if pg then hideLeaveGui(pg) end
            end)
        end
    end)

    pcall(function()
        GuiService.MenuOpened:Connect(function()
            task.spawn(function()
                task.wait(0.02)
                pcall(function() hideLeaveGui(getRobloxGui()) end)
                pcall(function() hideLeaveGui(CoreGui) end)
                pcall(function() GuiService:SetMenuIsOpen(false) end)
            end)
        end)
    end)
end

